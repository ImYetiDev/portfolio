---
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";
import LinkButton from "@/components/LinkButton.astro";
import GitHub from "@/components/icons/GitHub.astro";
import Link from "@/components/icons/Link.astro";

import { TAGS } from "@/data/tags";

import en from "../language/en.json";
import es from "../language/es.json";

const lang = Astro.cookies.get("lang")?.value || "en";

const PROJECTS = lang === "es" ? es.PROJECTS : en.PROJECTS;

const titlePag =
  lang === "es"
    ? "Proyectos personales"
    : "Personal Projects";

const pageDescription =
  lang === "es"
    ? "Explora mis proyectos personales, experimentos y proyectos de aprendizaje."
    : "Explore my personal projects, experiments, and learning projects.";

const labels = {
  back:
    lang === "es"
      ? "Volver al inicio"
      : "Back to Home",

  details:
    lang === "es"
      ? "Ver detalles"
      : "View details",

  preview:
    lang === "es"
      ? "Ver proyecto"
      : "Preview",

  code:
    lang === "es"
      ? "Código"
      : "Code",
};
---

<Layout title={titlePag} description={pageDescription}>
  <main class="px-4 py-20 max-w-7xl mx-auto space-y-12">
    <BackButton
      href="/"
      label={labels.back}
    />

    <h1 class="text-4xl font-bold text-center">
      {titlePag}
    </h1>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROJECTS.map(
          ({
            slug,
            title,
            description,
            images,
            tags,
            link,
            github,
          }) => (
            <article
              class="flex flex-col overflow-hidden rounded-xl
                     border border-gray-200 dark:border-gray-800
                     shadow transition duration-300
                     hover:-translate-y-1 hover:shadow-lg"
            >
              {
                images?.[0] && (
                  <a
                    href={`/projects/${slug}`}
                    class="block h-48 overflow-hidden"
                    aria-label={`View details for ${title}`}
                  >
                    <img
                      src={images[0]}
                      alt={title}
                      loading="lazy"
                      class="h-full w-full object-cover object-top
                             transition duration-500 hover:scale-105"
                    />
                  </a>
                )
              }

              <div class="flex flex-1 flex-col p-5">
                <h2
                  class="text-xl font-semibold
                         text-gray-900 dark:text-gray-100"
                >
                  <a
                    href={`/projects/${slug}`}
                    class="transition hover:text-blue-600
                           dark:hover:text-blue-400"
                  >
                    {title}
                  </a>
                </h2>

                <p
                  class="mt-3 text-sm leading-relaxed
                         text-gray-600 dark:text-gray-400"
                >
                  {description}
                </p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {
                    tags.map((key) => {
                      const tag =
                        TAGS[key as keyof typeof TAGS];

                      if (!tag) return null;

                      return (
                        <span
                          class={`flex items-center gap-x-1
                                  rounded-full px-2 py-1 text-xs
                                  ${tag.class}`}
                        >
                          <tag.icon class="size-4" />
                          {tag.name}
                        </span>
                      );
                    })
                  }
                </div>

                <footer class="mt-auto flex flex-wrap gap-3 pt-6">
                  <LinkButton href={`/projects/${slug}`}>
                    <Link class="size-4" />
                    {labels.details}
                  </LinkButton>

                  {
                    github && (
                      <LinkButton href={github}>
                        <GitHub class="size-5" />
                        {labels.code}
                      </LinkButton>
                    )
                  }

                  {
                    link && (
                      <LinkButton href={link}>
                        <Link class="size-4" />
                        {labels.preview}
                      </LinkButton>
                    )
                  }
                </footer>
              </div>
            </article>
          )
        )
      }
    </div>
  </main>
</Layout>