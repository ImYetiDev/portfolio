---
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";
import LinkButton from "@/components/LinkButton.astro";
import GitHub from "@/components/icons/GitHub.astro";
import Link from "@/components/icons/Link.astro";

import { TAGS } from "@/data/tags";

import en from "../../language/en.json";
import es from "../../language/es.json";

const lang = Astro.cookies.get("lang")?.value || "en";

const PROJECTS =
  lang === "es"
    ? es.PROJECTS
    : en.PROJECTS;

const { slug } = Astro.params;

const project = PROJECTS.find(
  (project) => project.slug === slug
);

if (!project) {
  throw new Error(
    lang === "es"
      ? "Proyecto no encontrado"
      : "Project not found"
  );
}

const labels = {
  back:
    lang === "es"
      ? "Volver a proyectos"
      : "Back to Projects",

  about:
    lang === "es"
      ? "Sobre el proyecto"
      : "About the project",

  technologies:
    lang === "es"
      ? "Tecnologías"
      : "Technologies",

  highlights:
    lang === "es"
      ? "Características y aprendizajes"
      : "Features & Learnings",

  code:
    lang === "es"
      ? "Ver código"
      : "View Code",

  demo:
    lang === "es"
      ? "Ver demo"
      : "View Demo",
};
---

<Layout
  title={project.title}
  description={project.description}
>
  <main class="px-4 py-20 max-w-5xl mx-auto space-y-12">
    <BackButton
      href="/projects"
      label={labels.back}
    />

    <header class="space-y-4">
      <h1
        class="text-4xl font-bold text-center
               text-gray-900 dark:text-gray-100"
      >
        {project.title}
      </h1>

      <p
        class="mx-auto max-w-3xl text-center
               text-lg text-gray-600 dark:text-gray-400"
      >
        {project.description}
      </p>
    </header>

    {
      project.images.length > 0 && (
        <section
          class:list={[
            "grid gap-4",
            project.images.length === 1
              ? "grid-cols-1"
              : "sm:grid-cols-2",
          ]}
        >
          {project.images.map((image, index) => (
            <img
              src={image}
              alt={`${project.title} - ${index + 1}`}
              loading="lazy"
              class="w-full rounded-xl object-cover
                     border border-gray-200
                     dark:border-gray-800"
            />
          ))}
        </section>
      )
    }

    <section class="space-y-4">
      <h2
        class="text-2xl font-bold
               text-gray-900 dark:text-gray-100"
      >
        {labels.about}
      </h2>

      <p
        class="text-lg leading-relaxed
               text-gray-700 dark:text-gray-300"
      >
        {project.detail.description}
      </p>
    </section>

    <section class="space-y-4">
      <h2
        class="text-2xl font-bold
               text-gray-900 dark:text-gray-100"
      >
        {labels.technologies}
      </h2>

      <div class="flex flex-wrap gap-3">
        {
          project.tags.map((key) => {
            const tag =
              TAGS[key as keyof typeof TAGS];

            if (!tag) return null;

            return (
              <span
                class={`flex items-center gap-2
                        rounded-full px-3 py-1 text-sm
                        ${tag.class}`}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            );
          })
        }
      </div>
    </section>

    {
      project.detail.highlights.length > 0 && (
        <section class="space-y-4">
          <h2
            class="text-2xl font-bold
                   text-gray-900 dark:text-gray-100"
          >
            {labels.highlights}
          </h2>

          <ul
            class="list-disc space-y-2 pl-6
                   text-gray-700 dark:text-gray-300"
          >
            {project.detail.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (project.github || project.link) && (
        <footer class="flex flex-wrap gap-4 pt-4">
          {project.github && (
            <LinkButton href={project.github}>
              <GitHub class="size-5" />
              {labels.code}
            </LinkButton>
          )}

          {project.link && (
            <LinkButton href={project.link}>
              <Link class="size-4" />
              {labels.demo}
            </LinkButton>
          )}
        </footer>
      )
    }
  </main>
</Layout>