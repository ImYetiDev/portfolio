---
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";
import LinkButton from "@/components/LinkButton.astro";
import GitHub from "@/components/icons/GitHub.astro";
import Link from "@/components/icons/Link.astro";
import ImageGallery from "@/components/ImageGallery.astro";

import { TAGS } from "@/data/tags";

import en from "../../language/en.json";
import es from "../../language/es.json";

const lang = Astro.cookies.get("lang")?.value || "en";

const PRODUCTS =
  lang === "es"
    ? es.SOLD_PRODUCTS
    : en.SOLD_PRODUCTS;

const labels =
  lang === "es"
    ? es.SOLD_PRODUCTS_LABELS
    : en.SOLD_PRODUCTS_LABELS;

const { slug } = Astro.params;

const product = PRODUCTS.find(
  (product) => product.slug === slug
);

if (!product) {
  throw new Error(
    lang === "es"
      ? "Producto no encontrado"
      : "Product not found"
  );
}

const uiLabels = {
  back:
    lang === "es"
      ? "Volver a productos vendidos"
      : "Back to Sold Products",

  code:
    lang === "es"
      ? "Ver código"
      : "View Code",

  demo:
    lang === "es"
      ? "Ver demo"
      : "View Demo",

  close:
    lang === "es"
      ? "Cerrar imagen"
      : "Close image",
};
---

<Layout
  title={product.title}
  description={product.description}
>
  <main class="px-4 py-20 max-w-7xl mx-auto space-y-12">

    <BackButton
      href="/productos-vendidos"
      label={uiLabels.back}
    />

    <header class="space-y-5">
      <h1
        class="text-4xl font-bold text-center
               text-gray-900 dark:text-gray-100"
      >
        {product.title}
      </h1>

      {
        product.showCompany && (
          <p
            class="text-center text-sm font-medium
                   text-gray-500 dark:text-gray-400"
          >
            {labels.company}: {product.company}
          </p>
        )
      }

      <p
        class="mx-auto max-w-3xl text-center
               text-lg text-gray-600 dark:text-gray-400"
      >
        {product.description}
      </p>

      {
        ((product.showCode && product.codeUrl) || product.link) && (
          <div class="flex flex-wrap justify-center gap-4 pt-2">

            {
              product.showCode && product.codeUrl && (
                <LinkButton href={product.codeUrl}>
                  <GitHub class="size-5" />
                  {product.codeLabel || uiLabels.code}
                </LinkButton>
              )
            }

            {
              product.link && (
                <LinkButton href={product.link}>
                  <Link class="size-4" />
                  {uiLabels.demo}
                </LinkButton>
              )
            }

          </div>
        )
      }
    </header>

    {
      product.showImages && (
        <ImageGallery
          images={product.images || []}
          title={product.title}
          closeLabel={uiLabels.close}
        />
      )
    }

    <section
      class="mx-auto grid max-w-5xl gap-8
             md:grid-cols-2"
    >
      <div class="space-y-3">
        <h2
          class="text-2xl font-bold
                 text-gray-900 dark:text-gray-100"
        >
          {labels.summary}
        </h2>

        <p
          class="text-lg leading-relaxed
                 text-gray-700 dark:text-gray-300"
        >
          {product.detail.summary}
        </p>
      </div>

      <div class="space-y-3">
        <h2
          class="text-2xl font-bold
                 text-gray-900 dark:text-gray-100"
        >
          {labels.role}
        </h2>

        <p
          class="text-lg leading-relaxed
                 text-gray-700 dark:text-gray-300"
        >
          {product.detail.role}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-5xl space-y-4">
      <h2
        class="text-2xl font-bold
               text-gray-900 dark:text-gray-100"
      >
        {labels.stack}
      </h2>

      <div class="flex flex-wrap gap-3">
        {
          product.detail.stack.map((key) => {
            const tag =
              TAGS[key as keyof typeof TAGS];

            if (!tag) return null;

            return (
              <span
                class={`flex items-center gap-2
                        rounded-full px-3 py-1 text-sm
                        ${tag.class}`}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            );
          })
        }
      </div>
    </section>

    {
      product.detail.highlights.length > 0 && (
        <section class="mx-auto max-w-5xl space-y-4">
          <h2
            class="text-2xl font-bold
                   text-gray-900 dark:text-gray-100"
          >
            {labels.highlights}
          </h2>

          <ul
            class="list-disc space-y-2 pl-6
                   text-gray-700 dark:text-gray-300"
          >
            {
              product.detail.highlights.map(
                (highlight) => (
                  <li>{highlight}</li>
                )
              )
            }
          </ul>
        </section>
      )
    }

  </main>
</Layout>