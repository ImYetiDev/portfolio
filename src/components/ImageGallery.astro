---
interface Props {
  images: string[];
  title: string;
  closeLabel?: string;
}

const {
  images = [],
  title,
  closeLabel = "Close image",
} = Astro.props;
---

{
  images.length > 0 && (
    <>
      <section
        data-image-gallery
        class:list={[
          "grid gap-6",
          images.length === 1
            ? "grid-cols-1 max-w-5xl mx-auto"
            : "md:grid-cols-2",
        ]}
      >
        {images.map((image, index) => (
          <button
            type="button"
            class="group relative block w-full overflow-hidden
                   rounded-xl border border-gray-200
                   bg-gray-100 shadow-md
                   transition duration-300
                   hover:-translate-y-1 hover:shadow-xl
                   dark:border-gray-800 dark:bg-gray-900"
            data-lightbox-trigger
            data-index={index}
            data-image={image}
            data-alt={`${title} - ${index + 1}`}
            aria-label={`${title} - ${index + 1}`}
          >
            <img
              src={image}
              alt={`${title} - ${index + 1}`}
              loading="lazy"
              class="h-auto w-full object-contain
                     transition duration-500
                     group-hover:scale-[1.02]"
            />
          </button>
        ))}
      </section>

      <div
        data-lightbox
        class="fixed inset-0 z-[100]
               hidden items-center justify-center
               bg-black/90 p-4
               backdrop-blur-sm
               sm:p-8"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
      >
        <button
          type="button"
          data-lightbox-close
          aria-label={closeLabel}
          class="absolute right-5 top-5 z-30
                 flex h-11 w-11 items-center justify-center
                 rounded-full bg-black/60
                 text-3xl text-white
                 transition hover:bg-black"
        >
          ×
        </button>

        {
          images.length > 1 && (
            <button
              type="button"
              data-lightbox-prev
              aria-label="Previous image"
              class="absolute left-3 top-1/2 z-30
                     flex h-12 w-12 -translate-y-1/2
                     items-center justify-center
                     rounded-full bg-black/60
                     text-4xl text-white
                     transition
                     hover:bg-black
                     sm:left-6 sm:h-14 sm:w-14"
            >
              ‹
            </button>
          )
        }

        <img
          data-lightbox-image
          src=""
          alt=""
          class="max-h-[90vh] max-w-[95vw]
                 select-none rounded-xl object-contain
                 shadow-2xl"
        />

        {
          images.length > 1 && (
            <button
              type="button"
              data-lightbox-next
              aria-label="Next image"
              class="absolute right-3 top-1/2 z-30
                     flex h-12 w-12 -translate-y-1/2
                     items-center justify-center
                     rounded-full bg-black/60
                     text-4xl text-white
                     transition
                     hover:bg-black
                     sm:right-6 sm:h-14 sm:w-14"
            >
              ›
            </button>
          )
        }

        {
          images.length > 1 && (
            <div
              data-lightbox-counter
              class="absolute bottom-5 left-1/2 z-30
                     -translate-x-1/2
                     rounded-full bg-black/60
                     px-4 py-2 text-sm text-white"
            />
          )
        }
      </div>
    </>
  )
}

<script>
  function initializeImageGallery() {
    const galleries = document.querySelectorAll<HTMLElement>(
      "[data-image-gallery]"
    );

    galleries.forEach((gallery) => {
      if (gallery.dataset.initialized === "true") {
        return;
      }

      gallery.dataset.initialized = "true";

      const lightbox =
        gallery.nextElementSibling as HTMLElement | null;

      if (!lightbox?.hasAttribute("data-lightbox")) {
        return;
      }

      const triggers = Array.from(
        gallery.querySelectorAll<HTMLElement>(
          "[data-lightbox-trigger]"
        )
      );

      const lightboxImage =
        lightbox.querySelector<HTMLImageElement>(
          "[data-lightbox-image]"
        );

      const closeButton =
        lightbox.querySelector<HTMLButtonElement>(
          "[data-lightbox-close]"
        );

      const previousButton =
        lightbox.querySelector<HTMLButtonElement>(
          "[data-lightbox-prev]"
        );

      const nextButton =
        lightbox.querySelector<HTMLButtonElement>(
          "[data-lightbox-next]"
        );

      const counter =
        lightbox.querySelector<HTMLElement>(
          "[data-lightbox-counter]"
        );

      if (!lightboxImage || triggers.length === 0) {
        return;
      }

      let currentIndex = 0;

      const updateImage = () => {
        const trigger = triggers[currentIndex];

        if (!trigger) {
          return;
        }

        const image = trigger.dataset.image;
        const alt = trigger.dataset.alt ?? "";

        if (!image) {
          return;
        }

        lightboxImage.src = image;
        lightboxImage.alt = alt;

        if (counter) {
          counter.textContent =
            `${currentIndex + 1} / ${triggers.length}`;
        }
      };

      const openLightbox = (index: number) => {
        currentIndex = index;

        updateImage();

        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        lightbox.setAttribute("aria-hidden", "false");

        document.body.style.overflow = "hidden";
      };

      const closeLightbox = () => {
        lightbox.classList.remove("flex");
        lightbox.classList.add("hidden");
        lightbox.setAttribute("aria-hidden", "true");

        lightboxImage.src = "";
        lightboxImage.alt = "";

        document.body.style.overflow = "";
      };

      const showNextImage = () => {
        currentIndex =
          (currentIndex + 1) % triggers.length;

        updateImage();
      };

      const showPreviousImage = () => {
        currentIndex =
          (currentIndex - 1 + triggers.length) %
          triggers.length;

        updateImage();
      };

      gallery.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;

        const trigger = target.closest<HTMLElement>(
          "[data-lightbox-trigger]"
        );

        if (!trigger) {
          return;
        }

        const index = Number(
          trigger.dataset.index
        );

        if (Number.isNaN(index)) {
          return;
        }

        openLightbox(index);
      });

      closeButton?.addEventListener(
        "click",
        closeLightbox
      );

      nextButton?.addEventListener(
        "click",
        (event) => {
          event.stopPropagation();
          showNextImage();
        }
      );

      previousButton?.addEventListener(
        "click",
        (event) => {
          event.stopPropagation();
          showPreviousImage();
        }
      );

      lightbox.addEventListener(
        "click",
        (event) => {
          if (event.target === lightbox) {
            closeLightbox();
          }
        }
      );

      const handleKeydown = (
        event: KeyboardEvent
      ) => {
        if (
          lightbox.getAttribute("aria-hidden") !==
          "false"
        ) {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
          return;
        }

        if (
          event.key === "ArrowRight" &&
          triggers.length > 1
        ) {
          showNextImage();
          return;
        }

        if (
          event.key === "ArrowLeft" &&
          triggers.length > 1
        ) {
          showPreviousImage();
        }
      };

      document.addEventListener(
        "keydown",
        handleKeydown
      );
    });
  }

  initializeImageGallery();

  document.addEventListener(
    "astro:page-load",
    initializeImageGallery
  );
</script>